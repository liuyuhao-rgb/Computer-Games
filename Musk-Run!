<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>躲避星舰</title>
<style>
  html, body { margin: 0; height: 100%; background: #07070f; color: #fff; font-family: "PingFang SC", "Microsoft YaHei", sans-serif; }
  body { display: flex; flex-direction: column; align-items: center; justify-content: center; }
  canvas { background: #0b0b1a; border: 2px solid #333; max-width: 100vw; max-height: 85vh; }
  p { color: #889; font-size: 14px; margin: 8px 0 0; }
</style>
</head>
<body>
<canvas id="game" width="900" height="600"></canvas>
<p>← → 或 A / D 移动 · 空格 / ↑ 跳跃 · P 暂停 · 回车开始 / 重来</p>

<script>
(() => {
  const canvas = document.getElementById('game');
  const ctx = canvas.getContext('2d');
  const W = canvas.width, H = canvas.height;
  const GROUND = H - 60;

  // ---------- 输入 ----------
  const keys = {};
  addEventListener('keydown', e => {
    if (['ArrowLeft','ArrowRight','ArrowUp','ArrowDown',' '].includes(e.key)) e.preventDefault();
    keys[e.key.toLowerCase()] = true;
    if (e.key === 'Enter' && state !== 'playing') start();
    if (e.key.toLowerCase() === 'p') togglePause();
  });
  addEventListener('keyup', e => { keys[e.key.toLowerCase()] = false; });

  // ---------- 音效（可选，简单蜂鸣） ----------
  let audio;
  function beep(freq, dur, type = 'square', vol = 0.05) {
    try {
      audio = audio || new (window.AudioContext || window.webkitAudioContext)();
      const o = audio.createOscillator(), g = audio.createGain();
      o.type = type; o.frequency.value = freq; g.gain.value = vol;
      o.connect(g); g.connect(audio.destination);
      o.start(); g.gain.exponentialRampToValueAtTime(0.0001, audio.currentTime + dur);
      o.stop(audio.currentTime + dur);
    } catch (e) {}
  }

  // ---------- 状态 ----------
  let state = 'title'; // title | playing | paused | over
  let player, ships, blasts, stars, score, best, timeAlive, spawnTimer, shake;
  best = 0;
  try { best = +localStorage.getItem('dodge-best') || 0; } catch (e) {}

  stars = Array.from({ length: 80 }, () => ({ x: Math.random() * W, y: Math.random() * GROUND, r: Math.random() * 1.6 + 0.3, s: Math.random() * 0.3 + 0.1 }));

  function start() {
    player = { x: W / 2, y: GROUND, vy: 0, w: 34, h: 62, dir: 1, onGround: true };
    ships = []; blasts = [];
    score = 0; timeAlive = 0; spawnTimer = 0; shake = 0;
    state = 'playing';
  }
  function togglePause() {
    if (state === 'playing') state = 'paused';
    else if (state === 'paused') state = 'playing';
  }

  // ---------- 生成星舰 ----------
  function spawnShip() {
    const diff = Math.min(timeAlive / 60, 1);          // 60 秒内难度升到最高
    const big = Math.random() < 0.2;
    const w = big ? 46 : 30;
    ships.push({
      x: 40 + Math.random() * (W - 80),
      y: -120,
      w, h: w * 3.6,
      vy: 220 + diff * 280 + Math.random() * 90,
      // 偶尔带一点横向漂移
      vx: Math.random() < 0.3 + diff * 0.3 ? (Math.random() - 0.5) * 140 : 0,
      tilt: 0,
    });
  }

  // ---------- 更新 ----------
  function update(dt) {
    timeAlive += dt;
    score += dt * 10;

    // 玩家
    const speed = 340;
    let move = 0;
    if (keys['arrowleft'] || keys['a']) move -= 1;
    if (keys['arrowright'] || keys['d']) move += 1;
    if (move) player.dir = move;
    player.x = Math.max(player.w / 2, Math.min(W - player.w / 2, player.x + move * speed * dt));
    if ((keys[' '] || keys['arrowup'] || keys['w']) && player.onGround) {
      player.vy = -640; player.onGround = false; beep(520, 0.1, 'square', 0.03);
    }
    player.vy += 1700 * dt;
    player.y += player.vy * dt;
    if (player.y >= GROUND) { player.y = GROUND; player.vy = 0; player.onGround = true; }

    // 生成：越往后越密
    const diff = Math.min(timeAlive / 60, 1);
    spawnTimer -= dt;
    if (spawnTimer <= 0) {
      spawnShip();
      spawnTimer = 0.9 - diff * 0.6 + Math.random() * 0.3;
    }

    // 星舰
    for (const s of ships) {
      s.y += s.vy * dt;
      s.x += s.vx * dt;
      s.tilt = Math.atan2(s.vx, s.vy);
      if (s.x < 20 || s.x > W - 20) s.vx *= -1;
      if (s.y + s.h >= GROUND && !s.dead) {
        s.dead = true;
        blasts.push({ x: s.x, y: GROUND, t: 0, r: 20 + s.w });
        shake = Math.max(shake, 6);
        beep(90, 0.25, 'sawtooth', 0.06);
        score += 5; // 躲掉一艘加分
      }
    }
    ships = ships.filter(s => !s.dead);

    // 爆炸
    for (const b of blasts) b.t += dt;
    blasts = blasts.filter(b => b.t < 0.5);

    shake = Math.max(0, shake - dt * 30);

    // 碰撞（判定框比图像略小，更宽容）
    const px = player.x - player.w / 2 + 5, py = player.y - player.h + 6, pw = player.w - 10, ph = player.h - 8;
    for (const s of ships) {
      const sx = s.x - s.w / 2 + 4, sy = s.y, sw = s.w - 8, sh = s.h - 6;
      if (px < sx + sw && px + pw > sx && py < sy + sh && py + ph > sy) return die();
    }
    for (const b of blasts) {
      if (b.t > 0.35) continue; // 爆炸末尾无伤害
      const r = b.r * (0.4 + b.t * 2);
      const cx = Math.max(px, Math.min(b.x, px + pw)), cy = Math.max(py, Math.min(b.y, py + ph));
      if ((cx - b.x) ** 2 + (cy - b.y) ** 2 < r * r * 0.6) return die();
    }
  }

  function die() {
    state = 'over';
    shake = 14;
    beep(140, 0.5, 'sawtooth', 0.08);
    if (score > best) {
      best = score;
      try { localStorage.setItem('dodge-best', String(Math.floor(best))); } catch (e) {}
    }
  }

  // ---------- 绘制 ----------
  function drawBackground() {
    const g = ctx.createLinearGradient(0, 0, 0, GROUND);
    g.addColorStop(0, '#05050f'); g.addColorStop(1, '#3a1a14');
    ctx.fillStyle = g; ctx.fillRect(0, 0, W, H);
    ctx.fillStyle = '#fff';
    for (const s of stars) {
      ctx.globalAlpha = 0.4 + s.r / 3;
      ctx.beginPath(); ctx.arc(s.x, s.y, s.r, 0, 7); ctx.fill();
    }
    ctx.globalAlpha = 1;
    // 地面（火星）
    ctx.fillStyle = '#a2472a'; ctx.fillRect(0, GROUND, W, H - GROUND);
    ctx.fillStyle = '#7d3320';
    for (let i = 0; i < 12; i++) ctx.fillRect((i * 97 + 20) % W, GROUND + 14 + (i % 3) * 14, 30 + (i % 4) * 10, 5);
  }

  function drawShip(s) {
    ctx.save();
    ctx.translate(s.x, s.y + s.h / 2);
    ctx.rotate(-s.tilt);                       // 头朝下，向漂移方向微倾
    const w = s.w, h = s.h;
    // 尾焰（在上方，因为船头朝下）
    const fl = 14 + Math.random() * 14;
    ctx.fillStyle = '#ff9d2e';
    ctx.beginPath(); ctx.moveTo(-w * 0.35, -h / 2); ctx.lineTo(0, -h / 2 - fl * 1.8); ctx.lineTo(w * 0.35, -h / 2); ctx.fill();
    ctx.fillStyle = '#fff3b0';
    ctx.beginPath(); ctx.moveTo(-w * 0.18, -h / 2); ctx.lineTo(0, -h / 2 - fl); ctx.lineTo(w * 0.18, -h / 2); ctx.fill();
    // 机身
    const g = ctx.createLinearGradient(-w / 2, 0, w / 2, 0);
    g.addColorStop(0, '#8d949c'); g.addColorStop(0.45, '#eef1f4'); g.addColorStop(1, '#7c838b');
    ctx.fillStyle = g;
    ctx.beginPath();
    ctx.moveTo(-w / 2, -h / 2);
    ctx.lineTo(w / 2, -h / 2);
    ctx.lineTo(w / 2, h * 0.18);
    ctx.quadraticCurveTo(w / 2, h / 2 - 4, 0, h / 2);   // 圆头（朝下）
    ctx.quadraticCurveTo(-w / 2, h / 2 - 4, -w / 2, h * 0.18);
    ctx.closePath(); ctx.fill();
    // 隔热瓦（黑色）
    ctx.fillStyle = '#1b1b1f';
    ctx.beginPath();
    ctx.moveTo(-w * 0.18, h * 0.3); ctx.quadraticCurveTo(0, h / 2 + 2, w * 0.18, h * 0.3); ctx.fill();
    // 分段线
    ctx.strokeStyle = 'rgba(0,0,0,0.25)'; ctx.lineWidth = 1;
    for (let i = 1; i < 5; i++) { const yy = -h / 2 + (h * 0.6 * i) / 5; ctx.beginPath(); ctx.moveTo(-w / 2, yy); ctx.lineTo(w / 2, yy); ctx.stroke(); }
    // 翼
    ctx.fillStyle = '#6c737a';
    ctx.beginPath(); ctx.moveTo(-w / 2, h * 0.12); ctx.lineTo(-w * 0.95, h * 0.28); ctx.lineTo(-w / 2, h * 0.3); ctx.fill();
    ctx.beginPath(); ctx.moveTo(w / 2, h * 0.12); ctx.lineTo(w * 0.95, h * 0.28); ctx.lineTo(w / 2, h * 0.3); ctx.fill();
    ctx.beginPath(); ctx.moveTo(-w / 2, -h * 0.4); ctx.lineTo(-w * 0.85, -h * 0.5); ctx.lineTo(-w / 2, -h * 0.25); ctx.fill();
    ctx.beginPath(); ctx.moveTo(w / 2, -h * 0.4); ctx.lineTo(w * 0.85, -h * 0.5); ctx.lineTo(w / 2, -h * 0.25); ctx.fill();
    ctx.restore();
  }

  function drawPlayer() {
    const p = player;
    ctx.save();
    ctx.translate(p.x, p.y);
    ctx.scale(p.dir, 1);
    const run = p.onGround && (keys['arrowleft'] || keys['arrowright'] || keys['a'] || keys['d']);
    const leg = run ? Math.sin(performance.now() / 70) * 6 : 0;
    // 腿
    ctx.fillStyle = '#1c1c28';
    ctx.fillRect(-9, -22, 7, 22 + leg * 0.3);
    ctx.fillRect(2, -22, 7, 22 - leg * 0.3);
    // 鞋
    ctx.fillStyle = '#111';
    ctx.fillRect(-10, -2 + leg * 0.3, 10, 3); ctx.fillRect(2, -2 - leg * 0.3, 10, 3);
    // 身体（黑色外套）
    ctx.fillStyle = '#25252f'; ctx.fillRect(-13, -46, 26, 26);
    ctx.fillStyle = '#eee'; ctx.fillRect(-3, -46, 6, 14);        // 衬衫
    // 手臂（跳起时举起）
    ctx.fillStyle = '#25252f';
    const arm = p.onGround ? 0 : -14;
    ctx.fillRect(-17, -44 + arm, 5, 20); ctx.fillRect(12, -44 + arm, 5, 20);
    // 头
    ctx.fillStyle = '#f0c8a0'; ctx.beginPath(); ctx.arc(0, -55, 11, 0, 7); ctx.fill();
    ctx.fillStyle = '#4a3320'; ctx.beginPath(); ctx.arc(0, -59, 11, Math.PI, 0); ctx.fill();   // 头发
    // 眼睛
    ctx.fillStyle = '#000'; ctx.fillRect(2, -56, 2, 3); ctx.fillRect(-5, -56, 2, 3);
    ctx.restore();
  }

  function drawBlast(b) {
    const k = b.t / 0.5, r = b.r * (0.4 + k * 2);
    ctx.globalAlpha = 1 - k;
    ctx.fillStyle = '#ff6a1a'; ctx.beginPath(); ctx.arc(b.x, b.y, r, Math.PI, 0); ctx.fill();
    ctx.fillStyle = '#ffd36b'; ctx.beginPath(); ctx.arc(b.x, b.y, r * 0.6, Math.PI, 0); ctx.fill();
    ctx.globalAlpha = 1;
  }

  function text(str, x, y, size, color = '#fff', align = 'center') {
    ctx.fillStyle = color; ctx.font = `bold ${size}px "PingFang SC","Microsoft YaHei",sans-serif`; ctx.textAlign = align;
    ctx.fillText(str, x, y);
  }

  function render() {
    ctx.save();
    if (shake > 0) ctx.translate((Math.random() - 0.5) * shake, (Math.random() - 0.5) * shake);
    drawBackground();
    if (state !== 'title') {
      ships.forEach(drawShip);
      blasts.forEach(drawBlast);
      if (state !== 'over') drawPlayer();
      text('分数 ' + Math.floor(score), 20, 36, 24, '#fff', 'left');
      text('最高 ' + Math.floor(best), W - 20, 36, 24, '#ffd36b', 'right');
    }
    ctx.restore();

    if (state === 'title') {
      text('躲避星舰', W / 2, 220, 64, '#fff');
      text('马斯克在火星上，星舰正在从天而降……', W / 2, 270, 22, '#ccd');
      text('按 回车 开始', W / 2, 360, 28, '#ffd36b');
      text('← → 移动   空格 跳跃', W / 2, 410, 18, '#99a');
      if (best) text('最高分 ' + Math.floor(best), W / 2, 460, 20, '#99a');
    } else if (state === 'paused') {
      ctx.fillStyle = 'rgba(0,0,0,0.5)'; ctx.fillRect(0, 0, W, H);
      text('已暂停', W / 2, H / 2, 48); text('按 P 继续', W / 2, H / 2 + 40, 20, '#ccd');
    } else if (state === 'over') {
      ctx.fillStyle = 'rgba(0,0,0,0.55)'; ctx.fillRect(0, 0, W, H);
      text('被星舰砸中了！', W / 2, 240, 52, '#ff6a6a');
      text('本局得分 ' + Math.floor(score), W / 2, 300, 30);
      text('最高分 ' + Math.floor(best), W / 2, 340, 24, '#ffd36b');
      text('按 回车 再来一次', W / 2, 410, 26, '#fff');
    }
  }

  // ---------- 主循环 ----------
  let last = performance.now();
  function frame(now) {
    const dt = Math.min((now - last) / 1000, 0.05);
    last = now;
    for (const s of stars) { s.x -= s.s * dt * 20; if (s.x < 0) s.x = W; }
    if (state === 'playing') update(dt);
    else if (state === 'over') shake = Math.max(0, shake - dt * 30);
    render();
    requestAnimationFrame(frame);
  }
  requestAnimationFrame(frame);
})();
</script>
</body>
</html>
